{
  "name": "doubao-translate",
  "version": "0.5.0",
  "description": "Doubao web translation as a magpie plugin: 180 target languages, server-held %% separators, three protocols, three engines. The Cloudflare Worker build lives in worker/.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./server": "./src/index.mjs"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:worker": "npm --prefix worker run build",
    "test:worker": "npm --prefix worker test"
  },
  "magpie": {
    "name": "豆包翻译（doubao-translate）",
    "icon": "data:image/svg+xml;base64,",
    "summary": {
      "en": "Doubao web translation for magpie: 180 target languages, no %% separator drift, three protocols.",
      "zh": "把豆包网页翻译接入 magpie：180 种目标语言、%% 分隔符由服务端保管不会漂移、支持三种协议。"
    },
    "options": {
      "targetLang": "zh",
      "scene": 2,
      "maxConcurrency": 4,
      "requestTimeoutMs": 45000,
      "totalTimeoutMs": 180000,
      "authTimeoutMs": 10000,
      "maxRetries": 1
    }
  }
}
